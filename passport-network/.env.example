# passport-network 런타임 환경변수 템플릿.
# 복사: cp .env.example .env  후 모든 CHANGE_ME 를 실제 값으로 교체.
# .env 는 gitignore 됨(**/.env). 절대 커밋하지 말 것.
#
# ⚠️ PN-1: CA 부트스트랩 자격증명을 Fabric 기본값(잘 알려진 디폴트)으로 두지 말 것.
#   기본 비밀번호는 공개된 값이라 5개 CA 전부에 재사용하면 신뢰 루트가 사실상 무방비.
#   각 값은 강한 난수(예: openssl rand -hex 24)로, 가능하면 CA/조직별로 다르게.

# ── Fabric 이미지 버전 ───────────────────────────────────────────
FABRIC_VERSION=2.5
FABRIC_CA_VERSION=1.5

# ── CA 부트스트랩 레지스트라 (전 CA 공통 주입) ───────────────────
CA_ADMIN_USER=CHANGE_ME
CA_ADMIN_PASSWORD=CHANGE_ME           # ⚠️ 기본/디폴트 비밀번호 재사용 금지
CA_PASSWORD_ATTEMPTS=10               # 브루트포스 방어: 실패 N회 시 identity 잠금

# ── CouchDB state DB 자격증명 ────────────────────────────────────
COUCHDB_USER=CHANGE_ME
COUCHDB_PASSWORD=CHANGE_ME

# ── 조직별 enrollment 시크릿 (CA register 시 사용) ───────────────
# Manufacturer
MANUFACTURER_ADMIN_SECRET=CHANGE_ME
MANUFACTURER_PEER0_SECRET=CHANGE_ME
MANUFACTURER_USER1_SECRET=CHANGE_ME
# EV Manufacturer
EVMANUFACTURER_ADMIN_SECRET=CHANGE_ME
EVMANUFACTURER_PEER0_SECRET=CHANGE_ME
EVMANUFACTURER_USER1_SECRET=CHANGE_ME
# Service
SERVICE_ADMIN_SECRET=CHANGE_ME
SERVICE_PEER0_SECRET=CHANGE_ME
SERVICE_USER1_SECRET=CHANGE_ME
# Regulator
REGULATOR_ADMIN_SECRET=CHANGE_ME
REGULATOR_PEER0_SECRET=CHANGE_ME
REGULATOR_USER1_SECRET=CHANGE_ME
# Orderer
ORDERER_ADMIN_SECRET=CHANGE_ME
ORDERER_NODE_SECRET=CHANGE_ME

# ── 운영 노출 제어 (PN-3) ────────────────────────────────────────
# operations/metrics 포트(9443-9447, 1X054)는 무인증 평문이라 기본 127.0.0.1 바인딩.
# 원격 Prometheus 스크레이프가 필요할 때만 아래를 0.0.0.0 으로.
# OPS_BIND_HOST=127.0.0.1
